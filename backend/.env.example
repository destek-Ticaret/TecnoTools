# Backend
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-string-min-32-chars
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# Database (Docker compose ile uyumlu varsayılan)
DATABASE_URL=postgresql+asyncpg://tecnotools:tecnotools@localhost:5432/tecnotools

# CORS — frontend origin'leri (virgülle ayır)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080

# PayTR (https://www.paytr.com/magaza/ayarlar)
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=1
PAYTR_NOTIFICATION_URL=http://localhost:8000/api/payments/paytr/callback
PAYTR_OK_URL=http://localhost:5500/order-success.html
PAYTR_FAIL_URL=http://localhost:5500/order-fail.html

# ── Kargo firmaları ─────────────────────────────────────────────────────
# Boş bırakılırsa: webhook imzası doğrulanmaz (firma push'u açık kabul edilir)
# ve canlı sorgu (sync) mock event döner. Webhook URL'i her firma için:
#   POST https://SENIN-DOMAIN/api/shipping/webhook/{ptt|aras|yurtici|mng|surat|hepsijet}
#   İmza header'ı: X-{Firma}-Signature: hex(hmac_sha256(secret, body))
# PTT (Kurumsal "Gönderi Takip" SOAP) — gerçek polling için kimlik:
PTT_USERNAME=
PTT_PASSWORD=
PTT_CUSTOMER_CODE=
PTT_WEBHOOK_SECRET=
ARAS_WEBHOOK_SECRET=
YURTICI_WEBHOOK_SECRET=
MNG_WEBHOOK_SECRET=
SURAT_WEBHOOK_SECRET=
HEPSIJET_WEBHOOK_SECRET=
# Gerçek API polling kimlikleri — boşsa sync() mock döner.
# Aras & Yurtiçi SOAP entegrasyonu canlı WSDL'e göre yazıldı; aşağıyı doldurunca
# gerçek takip sorgusu yapar (firma üye işyeri kimliğiyle).
ARAS_USERNAME=
ARAS_PASSWORD=
ARAS_INTEGRATION_CODE=
YURTICI_USERNAME=
YURTICI_PASSWORD=
# MNG (REST) / Sürat / Hepsijet gerçek polling'i firma entegrasyon dokümanı +
# kimlik geldiğinde eklenecek (şimdilik webhook + mock).

# İlk admin
INITIAL_ADMIN_USERNAME=TecnoTools
INITIAL_ADMIN_PASSWORD=ChangeMeOnFirstLogin!

# Storage backend: local | s3
# S3-compatible: AWS S3, Cloudflare R2, Backblaze B2, DigitalOcean Spaces, MinIO
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Public URL prefix (CDN veya bucket'ın public URL'i)
# Örn: https://cdn.tecnotools.com  veya  https://pub-xxx.r2.dev
S3_PUBLIC_BASE_URL=

# SMTP — boş bırakılırsa email'ler konsola yazılır (dev modu)
# Gmail App Password örneği: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USE_TLS=true
# Mailtrap (test): SMTP_HOST=sandbox.smtp.mailtrap.io, SMTP_PORT=2525
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@tecnotools.local
SMTP_FROM_NAME=TecnoTools
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Mağaza public URL (email linklerinde kullanılır)
STORE_PUBLIC_URL=http://localhost:5500

# Sentry — boşsa hata izleme devre dışı. https://sentry.io'dan ücretsiz hesap.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Datadog APM — boşsa devre dışı. DD_API_KEY zorunlu, DD_AGENT_HOST trace agent host'u.
# Production'da agent ayrı bir container olarak çalışır (docker-compose.prod.yml'ye datadog-agent eklenir).
DD_SERVICE=tecnotools-api
DD_ENV=production
DD_VERSION=1.0.0
DD_AGENT_HOST=
DD_TRACE_AGENT_PORT=8126
DD_API_KEY=
