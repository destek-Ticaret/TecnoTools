# Production env — bunu .env'e kopyalayıp gerçek değerlerle doldur.
# DİKKAT: Bu dosya .gitignore'da olsun, asla commit etme.

# ── App ──
APP_ENV=production
# 32+ karakter, rastgele üretilmiş (örn: python -c "import secrets; print(secrets.token_urlsafe(48))")
APP_SECRET_KEY=__REPLACE_WITH_RANDOM_64_CHARS__
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# ── PostgreSQL ──
POSTGRES_USER=tecnotools
POSTGRES_PASSWORD=__STRONG_DB_PASSWORD__
POSTGRES_DB=tecnotools

# ── CORS ──
CORS_ORIGINS=https://tecnotools.com,https://www.tecnotools.com

# ── PayTR (production credentials) ──
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=0
PAYTR_NOTIFICATION_URL=https://tecnotools.com/api/payments/paytr/callback
PAYTR_OK_URL=https://tecnotools.com/order-success.html
PAYTR_FAIL_URL=https://tecnotools.com/order-fail.html

# ── İlk admin (ilk deploy'da otomatik oluşturulur) ──
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=__STRONG_ADMIN_PASSWORD__

# ── SMTP ──
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=postmaster@tecnotools.com
SMTP_PASSWORD=__SMTP_PASSWORD__
SMTP_FROM_EMAIL=noreply@tecnotools.com
SMTP_FROM_NAME=TecnoTools
SMTP_USE_TLS=true

# ── Public mağaza URL'si (email linkleri için) ──
STORE_PUBLIC_URL=https://tecnotools.com
