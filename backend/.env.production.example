# Production env — Railway'de bu değişkenleri Environment Variables paneline gir.
# DİKKAT: Bu dosya sadece örnek şablondur, gerçek değerleri asla commit etme.

# ── App ──
APP_ENV=production
# python -c "import secrets; print(secrets.token_urlsafe(48))" ile üret
APP_SECRET_KEY=__REPLACE_WITH_RANDOM_64_CHARS__
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# ── PostgreSQL (Railway otomatik sağlar — kopyala/yapıştır) ──
# Railway'de Postgres servisini ekleyince DATABASE_URL otomatik gelir.
# Ama asyncpg driver gerektiği için başına +asyncpg ekle:
# postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=postgresql+asyncpg://__RAILWAY_POSTGRES_URL_BURAYA__

# ── CORS ──
CORS_ORIGINS=https://tecnotools.org,https://www.tecnotools.org

# ── PayTR (production credentials) ──
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=0
PAYTR_NOTIFICATION_URL=https://api.tecnotools.org/api/payments/paytr/callback
PAYTR_OK_URL=https://tecnotools.org/order-success.html
PAYTR_FAIL_URL=https://tecnotools.org/order-fail.html

# ── İlk admin (ilk deploy'da otomatik oluşturulur) ──
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=__STRONG_ADMIN_PASSWORD__

# ── E-posta ──
# ÖNEMLİ: Railway (ve birçok PaaS) giden SMTP portlarını (25/465/587) bloklar.
# Bu yüzden production'da Resend (HTTPS API, port 443) kullan.
#   1) resend.com'da kayıt ol, tecnotools.org domain'ini doğrula (DNS kayıtları).
#   2) API key üret, aşağıya gir.
# RESEND_API_KEY doluyken SMTP_* yok sayılır.
RESEND_API_KEY=re___REPLACE_WITH_RESEND_API_KEY__
SMTP_FROM_EMAIL=destek@tecnotools.org
SMTP_FROM_NAME=TecnoTools

# ── SMTP (yalnız SMTP portu açık ortamlarda; Railway'de çalışmaz) ──
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=destek@tecnotools.org
# SMTP_PASSWORD=__SMTP_PASSWORD__
# SMTP_USE_TLS=true

# ── Public mağaza URL'si (email linkleri için) ──
STORE_PUBLIC_URL=https://tecnotools.org
